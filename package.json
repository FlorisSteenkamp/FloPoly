{
    "name": "flo-poly",
    "sideEffects": false,
    "description": "A practical, root-focused JavaScript polynomial utility library.",
    "version": "9.0.1",
    "author": {
        "name": "Floris Steenkamp"
    },
    "private": false,
    "license": "MIT",
    "type": "module",
    "main": "./node/index.js",
    "exports": "./node/index.js",
    "engines": {
        "node": ">=20.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlorisSteenkamp/FloPoly.git"
    },
    "keywords": [
        "polynomial",
        "roots",
        "root",
        "finding"
    ],
    "bugs": {
        "url": "https://github.com/FlorisSteenkamp/FloPoly/issues"
    },
    "homepage": "https://github.com/FlorisSteenkamp/FloPoly",
    "dependencies": {
        "big-float-ts": "^4.0.4",
        "double-double": "^4.0.0",
        "squares-rng": "^2.0.4"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@swc/core": "^1.16.18",
        "@swc/jest": "^0.2.39",
        "@types/circular-dependency-plugin": "^5.0.8",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "c8": "^12.0.0",
        "circular-dependency-plugin": "^5.2.2",
        "jest": "^30.5.2",
        "jest-cli": "^30.5.2",
        "jest-ts-webcompat-resolver": "^1.0.1",
        "rimraf": "^6.1.3",
        "swc-loader": "^0.2.7",
        "typescript": "^7.0.2",
        "wast-loader": "^1.14.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    },
    "scripts": {
        "build": "npm run build-browser && npm run build-node",
        "build-node": "rimraf node && tsc",
        "build-browser": "rimraf browser && webpack",
        "test": "npm run typecheck && jest",
        "coverage": "c8 jest",
        "test-package": "npm pack",
        "typecheck": "tsc -p tsconfig.spec.json"
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true,
        "@parcel/watcher@2.6.0": true,
        "@swc/core@1.16.18": true
    }
}
